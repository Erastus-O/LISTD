# LISTD Pro — env var template
#
# Copy this file to `.env.local` (gitignored) and fill in real values.
# `.env.local` is loaded automatically by `next dev` / `next build` / route handlers.
# Values prefixed with NEXT_PUBLIC_ are bundled into the client; everything else stays server-only.
#
# IMPORTANT (per Next.js docs): .env files must live at the project root (this file),
# NOT inside src/. Next will not load them from src/.

# ---------- Public (client-bundled) ----------

# Supabase project URL — was VITE_SUPABASE_URL in the Lovable repo
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (formerly "anon key") — safe to expose; was VITE_SUPABASE_PUBLISHABLE_KEY in the Lovable repo
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin of the deployed app — used to build links in emails, OAuth callbacks, etc.
# Local dev: http://localhost:3000  |  Prod: https://listd.example.co.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Server-only: Database (Drizzle) ----------

# Pooled connection for runtime queries. Supabase Transaction Pooler, port 6543, with ?pgbouncer=true.
# Format: postgresql://postgres.<project-id>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Direct connection for `drizzle-kit pull|push|generate` (the pooler does not support DDL).
# Format: postgresql://postgres:<password>@db.<project-id>.supabase.co:5432/postgres
DIRECT_URL=

# Postgres connection pool size per Node process. Defaults to 10 (suits a
# single dev / runtime process). Set lower (e.g. 3) during `next build` so
# the worker fan-out doesn't exceed the Supabase pooler cap of 15.
DATABASE_POOL_MAX=

# ---------- Server-only: Supabase admin ----------

# Service-role key — bypasses RLS. Use only inside route handlers; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Server-only: Email (Resend) ----------

RESEND_API_KEY=

# ---------- Server-only: Xero (OAuth + invoicing) ----------

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Xero redirect URI must match what's registered in the Xero app.
# Will become: ${NEXT_PUBLIC_SITE_URL}/api/xero/callback after migration.

# ---------- Server-only: External-facing job APIs ----------

# Auth key consumers send to /api/jobs/new, /api/jobs/published, /api/cron/recycle-jobs, /api/cron/upsell-reminders
EXTERNAL_API_KEY=

# ---------- Server-only: InventoryBase ----------

INVENTORYBASE_CALENDAR_KEY=

# ---------- Server-only: Make.com webhook signature verification ----------

MAKE_WEBHOOK_SECRET=

# ---------- Server-only: Vercel Cron ----------

# Vercel sends `Authorization: Bearer ${CRON_SECRET}` to scheduled route handlers.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ---------- Server-only: Upstash Redis (dashboard KPI cache) ----------
#
# Powers src/lib/cache.ts. Same Upstash project serves both desktop and
# mobile workspaces — the helper namespaces keys per loader so cross-app
# collisions are impossible.
#
# Get the REST URL + token from the Upstash Console → Redis → "REST API".
# Local dev without these set: cache helper degrades to pass-through
# (calls the loader every time, no errors).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Server-only: Twilio (SMS notifications) ----------
#
# Powers src/lib/sms.ts → src/lib/notify-prefs.ts → appointment reminders +
# (eventually) all other transactional SMS sends. Honours the
# `notification_preferences.sms*` toggles on the user.
#
# Provision in the Twilio Console → Phone Numbers → buy a UK long code,
# OR (preferred) Console → Messaging → Services and create a Messaging
# Service with an alphanumeric sender ID "LISTD" attached. The Messaging
# Service handles failover, delivery routing, and STOP/HELP keywords
# automatically.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Preferred. Messaging Service SID — sends route through your configured
# senders + auto-handle STOP keyword. e.g. MGxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=
# Fallback only — used when Messaging Service SID is unset. Plain
# E.164 number, e.g. +447700000000. Don't combine with the service SID;
# the service is the better default.
TWILIO_FROM_NUMBER=
# Webhook signing token used to verify inbound STOP/HELP/SMS replies at
# /api/webhooks/twilio. Same value as TWILIO_AUTH_TOKEN unless you've
# rotated the request-validation token in the Twilio Console.
TWILIO_WEBHOOK_AUTH_TOKEN=

# ---------- Public + server: Web Push (VAPID keys for the mobile PWA) ----------
#
# Generate once via: `npx web-push generate-vapid-keys`. Same key pair is
# used by both workspaces — the mobile PWA reads NEXT_PUBLIC_VAPID_PUBLIC_KEY
# to register subscriptions; the cron in Listd-NEXT signs sends with the
# private key. Rotate both together (and force every client to re-subscribe).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact mailto used by Web Push protocol — push providers require this so
# they can reach the operator if your sender misbehaves. Use a real inbox.
VAPID_CONTACT_EMAIL=mailto:tech@listd.co.uk

# ---------- Server-only: Stripe (inbuilt invoice generator, Phase 6 pay-by-link) ----------

# Stripe secret API key (sk_live_… or sk_test_…). Powers Checkout session
# creation in src/lib/billing/inbuilt/provider.ts → createPaymentLink.
STRIPE_SECRET_KEY=

# Webhook signing secret for the /api/webhooks/stripe endpoint. Endpoint-
# scoped; rotate independently of STRIPE_SECRET_KEY. Find it in the Stripe
# Dashboard → Developers → Webhooks → <endpoint> → "Signing secret".
STRIPE_WEBHOOK_SECRET=

# ---------- Server-only: OpenRouter (agentic AI) ----------

# OpenRouter bearer token — the single API key for every model in the
# admin AI dropdown (Anthropic, OpenAI, Google …). Used by
# /api/clerk/ai/item-condition when a clerk taps "AI assist" on an
# inspection item. Sign up at https://openrouter.ai and create a key
# under Keys → Create. When unset the admin AI page shows a banner and
# every AI-assist call will 500.
OPENROUTER_API_KEY=
